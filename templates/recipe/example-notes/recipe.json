      "kind": "timezone",
      "default": "UTC",
      "description": "Time zone used for note timestamps.",
      "required": false
    }
  ],
  "volumes": [
    {
      "name_suffix": "data",
      "mount_path": "/data",
      "description": "Notes, attachments and the SQLite database."
    }
  ],
  "docs_url": "https://example.com/notes/docs",
