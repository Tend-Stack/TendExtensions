{
  "schema": 2,
  "id": "host.tend.calendar",
  "name": "Calendar",
  "version": "1.2.0",
  "author": "tend.host",
  "description": "A modern month, week, day and agenda calendar with local events, reminders, ICS import/export, keyboard control and a settings sheet, built to be the panel's default calendar.",
  "icon": "icon.svg",
  "ui": {
    "module": "index.js",
    "mount": "tool-window",
    "size": {
      "w": 720,
      "h": 560
    },
    "maxSize": {
      "w": 1400,
      "h": 1000
    }
  },
  "permissions": [
    "storage",
    "notifications"
  ],
  "widgets": [
    {
      "id": "upcoming",
      "name": "Upcoming",
      "description": "Today's date and your next events.",
      "sizes": [
        "small",
        "wide"
      ],
      "module": "widgets/upcoming.js",
      "preview": "widgets/upcoming-preview.svg"
    }
  ],
