{
  "schema": 2,
  "id": "host.tend.wordle",
  "name": "Word Guess",
  "version": "1.1.0",
  "author": "tend.host",
  "description": "Guess the hidden word in 6 tries. Green = correct position, yellow = wrong position, gray = not in word. Simple, elegant, addictive.",
  "icon": "icon.svg",
  "ui": {
    "module": "index.js",
    "mount": "tool-window",
    "size": {
      "w": 420,
      "h": 600
    },
    "minSize": {
      "w": 340,
      "h": 500
    },
    "maxSize": {
      "w": 720,
      "h": 860
    }
  },
  "permissions": [
    "storage"
  ],
  "runtime": {
    "api": 1,
    "kind": "game",
    "modules": [],
    "pauseWhenHidden": true,
    "targetFps": 60
  },
  "integrity": {
    "index.js": "sha256-zQn6r4/pttP739rA6CZaIXhDfDStqNtIX3uah2SDSew="
  }
}
