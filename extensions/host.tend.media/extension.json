{
  "schema": 2,
  "id": "host.tend.media",
  "name": "Tend Player",
  "version": "1.8.0",
  "author": "Tend",
  "description": "Radio stations, podcasts and audiobooks from OndaCast in one player, in the top bar and on your shelf: subscriptions, a queue, per-show speed, a sleep timer, transcripts, audiobook bookmarks, clips saved to Tend Notes, and Sprout can put anything on for you.",
  "icon": "icon.svg",
  "glyph": "glyph.svg",
  "ui": {
    "module": "index.js",
    "mount": "shell-app",
    "size": {
      "w": 1080,
      "h": 720
    },
    "minSize": {
      "w": 360,
      "h": 420
    }
  },
  "permissions": [
    "storage",
    "ondacast",
    "documents.read",
    "documents.write"
  ],
  "integrity": {
    "README.md": "sha256-yxPVnIN4YJUmtW3giJ7NIMHp36bxYxHwLgNO2hAv/Po=",
    "chunks/Cover-CFUQKa8h.js": "sha256-ftwsupLO+oJglGm6lC0CvllFxEGkturcWKq6o3fyhYE=",
    "chunks/Hint-DzWqDMB2.js": "sha256-oX/bct/2jS5hgxlVAg6CGrbPK61xE+NeziXIbzzukVc=",
    "chunks/Icon-CkCATa2J.js": "sha256-gue1tKPTver/pg6gSkmqa5NDaxBMF0zbdm3tCFXZEXU=",
    "chunks/Row-CbejDMJm.js": "sha256-m1P9LODQEdFctaz8a7EMYKRG+oFxq5Yj2KU9wUtrYQ8=",
    "chunks/model.svelte-A0MofO8E.js": "sha256-KO713jSRgZxIMD5JSCBZTQtjAlT1IfZLMtB90AFcbx0=",
    "glyph.svg": "sha256-qqRIgQEeU+LAKChWZj/HcWQFjMieQOD04EkDmU6eIwE=",
    "icon.svg": "sha256-SbSAyR4prIUkwozxPbf5VCyQH+gS9mYGZIByD0NeZXU=",
    "index.js": "sha256-u9TriZu/MX5/4ooK/ZznCUtb8YelzkY2/6QPwauzAmU=",
    "widgets/continue-preview.svg": "sha256-ysFuvId4mqfnxGNxeWXoIAMdO9Vc8Evthpv9GrDR12o=",
    "widgets/continue.js": "sha256-nKMh7/IHZfUFYAsGAPJwZa0PLPi9mQBvYu/wHpiPYSs=",
    "widgets/new-episodes-preview.svg": "sha256-qgF7hoDFjvMXtZDG6gCkdSpLf/d2c3exCu8UZJQuFX0=",
    "widgets/new-episodes.js": "sha256-BRnCbhW7xDXrvZxIsAlLL+1NFM6zP11HL764qFvMspE=",
    "widgets/now-playing-preview.svg": "sha256-z6EyYb/o0GG9mCxUIgZYq2FjgapyI4sdES3qYLLrlk0=",
    "widgets/now-playing.js": "sha256-/gEAs9InDOcmJT1apkTRHDiGvVzn1IvqygUFdSEXKP4=",
    "widgets/stations-preview.svg": "sha256-sqhHMsNRhKCBfzHvqKuSXjBP0DVZSmIGAqMfoKu6rw8=",
    "widgets/stations.js": "sha256-nv4c5vehz1hHEn8jNWBPYt5J+gh5fmCRHZgEpY0nyj0="
  },
  "widgets": [
    {
      "id": "now-playing",
      "name": "Now playing",
      "description": "What Tend Player is playing, with play/pause and next. Resume where you left off when nothing is on.",
      "sizes": [
        "small",
        "wide"
      ],
      "module": "widgets/now-playing.js",
      "preview": "widgets/now-playing-preview.svg"
    },
    {
      "id": "new-episodes",
      "name": "New episodes",
      "description": "The newest episodes of the shows you follow. Tap one to play it; the rest follow in Up next.",
      "sizes": [
        "small",
        "wide"
      ],
      "module": "widgets/new-episodes.js",
      "preview": "widgets/new-episodes-preview.svg"
    },
    {
      "id": "continue",
      "name": "Continue listening",
      "description": "Episodes and audiobooks in progress, with how much is left.",
      "sizes": [
        "small",
        "wide"
      ],
      "module": "widgets/continue.js",
      "preview": "widgets/continue-preview.svg"
    },
    {
      "id": "stations",
      "name": "Favorite stations",
      "description": "Your favorite radio stations, one tap to tune in.",
      "sizes": [
        "small",
        "wide"
      ],
      "module": "widgets/stations.js",
      "preview": "widgets/stations-preview.svg"
    }
  ],
  "sprout": {
    "tools": [
      {
        "name": "new_episodes",
        "kind": "read",
        "doing": "checking your shows",
        "description": "List unplayed episodes from the shows the person follows, newest first. Use it for any question about new episodes, then play one with its id.",
        "input": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "How many episodes to list, default 8."
            }
          }
        }
      },
      {
        "name": "search",
        "kind": "read",
        "doing": "looking for something to play",
        "description": "Find radio stations, podcast shows or audiobooks to play. Use category for a genre such as technology or rock, query for words such as lofi or a show name. Returns ids for the play tool.",
        "input": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "station",
                "podcast",
                "audiobook"
              ],
              "description": "What to look for."
            },
            "query": {
              "type": "string",
              "maxLength": 120,
              "description": "Words to search for, such as lofi, jazz or a show name."
            },
            "category": {
              "type": "string",
              "maxLength": 60,
              "description": "A genre, such as technology, true crime, rock or news. Lists the most popular first."
            }
          },
          "required": [
            "kind"
          ]
        }
      },
      {
        "name": "play",
        "kind": "ui",
        "doing": "putting it on",
        "description": "Start playing something now, using an id from the search or new_episodes tools. Set queue to new_episodes to line up the other new episodes behind it.",
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 120,
              "description": "An id returned by search or new_episodes."
            },
            "queue": {
              "type": "string",
              "enum": [
                "none",
                "new_episodes"
              ],
              "description": "new_episodes also queues the other new episodes. Default none."
            }
          },
          "required": [
            "id"
          ]
        }
      },
      {
        "name": "control",
        "kind": "ui",
        "doing": "adjusting playback",
        "description": "Pause, resume, skip to the next or previous item, or stop whatever Tend Player is playing right now.",
        "input": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "pause",
                "resume",
                "next",
                "previous",
                "stop"
              ],
              "description": "What to do with the current playback."
            }
          },
          "required": [
            "action"
          ]
        }
      }
    ]
  }
}
